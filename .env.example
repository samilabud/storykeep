# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Local Docker Postgres (see docker-compose.yml). These are local-only credentials.
DATABASE_URL=postgres://storykeep:storykeep@localhost:5440/storykeep
TEST_DATABASE_URL=postgres://storykeep:storykeep@localhost:5441/storykeep_test

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

APP_URL=http://localhost:3100

# LLM. "mock" needs no key and costs nothing. "anthropic" calls the real API.
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Each user may spend this many cents on LLM calls per UTC day.
LLM_DAILY_COST_CAP_CENTS=100

# Stripe. TEST MODE ONLY. The app refuses a key that is not sk_test_...
STRIPE_SECRET_KEY=
# Printed by `pnpm stripe:listen` (it starts with whsec_).
STRIPE_WEBHOOK_SECRET=
